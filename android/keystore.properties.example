# Copy to android/keystore.properties and fill in real values.
# NEVER commit keystore.properties or the keystore file itself.
#
# Generate a release keystore (one-time):
#   keytool -genkey -v -keystore ahd-release.keystore -alias ahd \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Recommended layout:
#   android/keystore/ahd-release.keystore   (gitignored via android/keystore/)
#   android/keystore.properties               (gitignored)

storeFile=keystore/ahd-release.keystore
storePassword=CHANGE_ME
keyAlias=ahd
keyPassword=CHANGE_ME
