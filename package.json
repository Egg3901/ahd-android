{
  "name": "ahd-android",
  "version": "0.4.0",
  "description": "Thin Android wrapper for A House Divided — a turn-based political simulation",
  "main": "index.js",
  "scripts": {
    "cap:sync": "cap sync android",
    "cap:add:android": "cap add android",
    "build:apk": "cd android && ./gradlew assembleDebug",
    "build:run": "cap sync android && cd android && ./gradlew installDebug",
    "open:android": "cap open android",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "keywords": [
    "capacitor",
    "android",
    "ahd",
    "political-sim"
  ],
  "author": "A House Divided",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "overrides": {
    "uuid": "^11.1.0"
  }
}
